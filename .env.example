# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Generate strong values, e.g.:  openssl rand -base64 24
# ---------------------------------------------------------------------------

# Database
DB_ROOT_PASSWORD=change_me_root
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=change_me_wp

# Published ports (must be UNIQUE per site on the host)
#   NGINX_PORT -> the port your Cloudflare Tunnel forwards to
#   PMA_PORT   -> phpMyAdmin, bound to 127.0.0.1 only
NGINX_PORT=9797
PMA_PORT=4441

# Site domain — used by the external wp-cron entry (scripts/wp-cron.cron.example).
SITE_DOMAIN=example.com

# Cloudflare Tunnel token (only if you run cloudflared per-site instead of host-level)
# Get it from: https://one.dash.cloudflare.com/ -> Networks -> Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...your_token_here
