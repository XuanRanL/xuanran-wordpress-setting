# Database Configuration
DB_ROOT_PASSWORD=your_secure_root_password
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=your_secure_wp_password

# Cloudflare Tunnel Token
# Get this from: https://one.dash.cloudflare.com/ → Networks → Tunnels
# After creating a tunnel, copy the token from the installation command
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiXXXXXXX...your_actual_token_here
